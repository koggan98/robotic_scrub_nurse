<CycloneDDS>
  <Domain>
    <General>
      <!-- autodetermine = pick the active interface automatically (WiFi today).
           For a dedicated wired NUC<->Jetson link, replace with a fixed address,
           e.g. <NetworkInterface address="192.168.50.1"/> on the NUC. -->
      <Interfaces>
        <NetworkInterface autodetermine="true"/>
      </Interfaces>
    </General>
    <Discovery>
      <Peers>
        <Peer Address="mirnuc.local"/>
        <Peer Address="orin.local"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
